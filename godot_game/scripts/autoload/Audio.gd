extends Node

## Autoload sound manager. Loads the baked .wav SFX (res://assets/audio/, generated by
## tools/build_audio.gd) with graceful null fallback, plays one-shots through a small round-robin
## pool of players, and runs the looping night ambience on a dedicated player. Everything is on the
## Master bus, so the existing Settings volume slider controls it all.

const DIR := "res://assets/audio/"
const POOL := 8

var _streams: Dictionary = {}
var _players: Array = []
var _next: int = 0
var _ambience: AudioStreamPlayer = null

func _ready() -> void:
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "Master"
		add_child(p)
		_players.append(p)
	_ambience = AudioStreamPlayer.new()
	_ambience.bus = "Master"
	_ambience.volume_db = -9.0  # background bed sits well under the one-shots
	add_child(_ambience)

func _stream(name: String) -> AudioStream:
	if _streams.has(name):
		return _streams[name]
	var path := DIR + name + ".wav"
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	_streams[name] = s
	return s

## Fire a one-shot. pitch_var randomizes pitch by ±value so repeated hits don't sound identical.
func play_sfx(name: String, pitch_var: float = 0.0, volume_db: float = 0.0) -> void:
	var s := _stream(name)
	if s == null:
		return
	var p: AudioStreamPlayer = _players[_next]
	_next = (_next + 1) % POOL
	p.stream = s
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.volume_db = volume_db
	p.play()

## Start/stop the looping night drone (called when the day/night phase changes).
func set_night(on: bool) -> void:
	if _ambience == null:
		return
	if on:
		if _ambience.stream == null:
			_ambience.stream = _stream("ambience_night")
		if _ambience.stream != null and not _ambience.playing:
			_ambience.play()
	else:
		_ambience.stop()

## Silence everything — used when leaving gameplay (death, victory, back to menu, fresh start).
func stop_all() -> void:
	if _ambience:
		_ambience.stop()
	for p in _players:
		p.stop()
